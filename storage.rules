rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isCookFitAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "support.mgm.studio@gmail.com";
    }

    match /recipe-images/{allPaths=**} {
      allow read: if true;
      allow create, update: if isCookFitAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isCookFitAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
